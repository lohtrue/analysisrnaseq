/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run lohtrue/analysisrnaseq -profile test,docker --outdir <OUTDIR>

    Reference: mouse chromosome 19 only (GRCm38, Ensembl release 102).
    The test GTF was created from the full Ensembl annotation with:
        curl -O https://ftp.ensembl.org/pub/release-102/gtf/mus_musculus/Mus_musculus.GRCm38.102.gtf.gz
        gunzip -c Mus_musculus.GRCm38.102.gtf.gz | awk -F'\t' '$1=="19" || /^#/' | gzip > Mus_musculus.GRCm38.102.chr19.gtf.gz
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '6.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset (mouse chr19) to check pipeline function'

    // Input data
    input     = "${projectDir}/assets/samplesheet.csv"

    // Reference genome (chr19 only, to keep memory usage and runtime low)
    fasta     = "${projectDir}/assets/test_data/Mus_musculus.GRCm38.dna.chromosome.19.fa.gz"
    gtf       = "${projectDir}/assets/test_data/Mus_musculus.GRCm38.102.chr19.gtf.gz"

    // Subsampling: fraction of reads to keep (passed to fq subsample as --probability)
    subsample = 0.1
    
}